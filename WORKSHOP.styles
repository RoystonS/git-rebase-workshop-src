/* Git Interactive Rebase Workshop - GitHub Pages styling */

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.7;
    color: #1f2937;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    background: #ffffff;
}

/* Headings */
h1 {
    font-size: 2rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
    margin-top: 2rem;
    color: #111827;
}

h2 {
    font-size: 1.5rem;
    color: #111827;
    margin-top: 2.5rem;
}

h3 {
    font-size: 1.2rem;
    color: #374151;
    margin-top: 1.8rem;
}

/* Code blocks */
pre {
    background: #1f2937;
    color: #f3f4f6;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.5;
}

code {
    font-family: 'Consolas', 'Monaco', 'Courier New', 'Cascadia Code', monospace;
    font-size: 0.9em;
}

p > code,
li > code {
    background: #f3f4f6;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
}

/* Lists */
ul, ol {
    padding-left: 1.5rem;
}

li {
    margin-bottom: 0.35rem;
}

/* Horizontal rules */
hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2.5rem 0;
}

/* Strong text */
strong {
    color: #111827;
}

/* Blockquotes - in case they're used */
blockquote {
    border-left: 4px solid #3b82f6;
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    background: #f8fafc;
    color: #475569;
    border-radius: 0 6px 6px 0;
}

blockquote p {
    margin: 0;
}

/* Tables - in case they're used */
table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
}

th, td {
    border: 1px solid #d1d5db;
    padding: 0.5rem 0.75rem;
    text-align: left;
}

th {
    background: #f9fafb;
    font-weight: 600;
}

tr:nth-child(even) {
    background: #f9fafb;
}

/* Links */
a {
    color: #2563eb;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

/* Task/problem labels (using strong within h3 or paragraphs) */
h3 strong {
    color: #2563eb;
}

/* Responsive */
@media (max-width: 640px) {
    body {
        padding: 1rem;
        font-size: 0.95rem;
    }
    h1 {
        font-size: 1.6rem;
    }
    h2 {
        font-size: 1.3rem;
    }
    pre {
        font-size: 0.8rem;
        padding: 0.75rem;
    }
}

/* Print */
@media print {
    body {
        font-size: 11pt;
        line-height: 1.5;
        color: #000;
    }
    pre {
        background: #f3f4f6;
        color: #000;
        border: 1px solid #d1d5db;
        page-break-inside: avoid;
    }
    h1, h2, h3 {
        page-break-after: avoid;
    }
}
